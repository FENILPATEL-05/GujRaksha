{
  "name": "gujraksha-cctv-platform",
  "version": "1.0.0",
  "description": "GujRaksha - Gujarat Industrial CCTV Asset Registry & Spatial GIS Platform",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/verify_and_fulfill_requirements.js",
    "start": "NODE_ENV=production node server.js",
    "dev": "node --watch-path=server.js --watch-path=src/routes --watch-path=src/services --watch-path=src/middleware --watch-path=src/config --watch-path=src/db server.js",
    "setup": "node scripts/init_postgres_db.js --reset && vite build",
    "db:init": "node scripts/init_postgres_db.js",
    "db:migrate": "node scripts/init_postgres_db.js --migrate",
    "db:seed": "node scripts/init_postgres_db.js --seed",
    "db:reset": "node scripts/init_postgres_db.js --reset",
    "prebuild": "node scripts/verify_and_fulfill_requirements.js",
    "build": "vite build"
  },
  "keywords": [
    "gujarat-police",
    "cctv-platform",
    "gis",
    "spatial-registry"
  ],
  "author": "Fenil Patel (GujRaksha)",
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.428.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.1"
  }
}
