    <script>
        // ── Font size ──
        let accFontLevel = parseInt(localStorage.getItem('acc-font') || '0');
        applyFont();

        function applyFont() {
            document.documentElement.style.fontSize = (16 + accFontLevel * 2) + 'px';
            localStorage.setItem('acc-font', accFontLevel);
        }

        function accFontSize(dir) {
            accFontLevel = Math.max(-3, Math.min(5, accFontLevel + dir));
            applyFont();
        }

        // ── Toggle class on body ──
        function accToggle(bodyClass, btnId) {
            document.body.classList.toggle(bodyClass);
            const btn = document.getElementById(btnId);
            btn.classList.toggle('active');
            localStorage.setItem(bodyClass, document.body.classList.contains(bodyClass) ? '1' : '0');
            console.log('Toggled', bodyClass, 'active:', btn.classList.contains('active'));
        }

        // ── Restore persisted states ──
        if (localStorage.getItem('acc-contrast') === '1') {
            document.body.classList.add('acc-contrast');
            document.getElementById('acc-contrast-btn').classList.add('active');
        }
        if (localStorage.getItem('acc-dyslexia') === '1') {
            document.body.classList.add('acc-dyslexia');
            document.getElementById('acc-dyslexia-btn').classList.add('active');
        }

        // ── Text-to-Speech ──
        let ttsUtterance = null;

        function accTTS() {
            if (window.speechSynthesis.speaking) {
                window.speechSynthesis.cancel();
                document.getElementById('acc-tts-label').textContent = 'Listen to Page';
                document.getElementById('acc-tts-btn').classList.remove('active');
                return;
            }
            const text = document.querySelector('main').innerText.replace(/\s+/g, ' ').trim();
            ttsUtterance = new SpeechSynthesisUtterance(text);
            ttsUtterance.lang = 'en-IN';
            ttsUtterance.rate = 0.95;
            ttsUtterance.onend = () => {
                document.getElementById('acc-tts-label').textContent = 'Listen to Page';
                document.getElementById('acc-tts-btn').classList.remove('active');
            };
            window.speechSynthesis.speak(ttsUtterance);
            document.getElementById('acc-tts-label').textContent = 'Stop Listening';
            document.getElementById('acc-tts-btn').classList.add('active');
        }

        // ── Reset all ──
        function accReset() {
            accFontLevel = 0;
            applyFont();
            ['acc-contrast', 'acc-dyslexia'].forEach(c => {
                document.body.classList.remove(c);
                localStorage.removeItem(c);
            });
            document.getElementById('acc-contrast').classList.remove('active');
            document.getElementById('acc-dyslexia-btn').classList.remove('active');
            if (window.speechSynthesis.speaking) window.speechSynthesis.cancel();
            document.getElementById('acc-tts-label').textContent = 'Listen to Page';
            document.getElementById('acc-tts-btn').classList.remove('active');
        }

        // ── Close panel on outside click ──
        document.addEventListener('click', e => {
            const panel = document.getElementById('acc-panel');
            const toggle = document.getElementById('acc-toggle');
            if (!panel.contains(e.target) && !toggle.contains(e.target)) {
                panel.classList.remove('open');
            }
        });
    </script>

    
    
    
