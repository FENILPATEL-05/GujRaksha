            const input = document.getElementById('gpChatInput');
            const msg = input.value.trim();
            if (!msg) return;
            gpAppendMsg(msg, 'user');
            input.value = '';
            const typing = gpAppendTyping();
            try {
                const res = await fetch('https://sentinel.gujarat.gov.in/chatbot', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': _gpCsrf
                    },
                    body: JSON.stringify({
                        message: msg
                    })
                });
                const data = await res.json();
                typing.remove();
                gpAppendMsg(data.reply, 'bot');
            } catch (e) {
                typing.remove();
                gpAppendMsg('Sorry, something went wrong. Please try again.', 'bot');
            }
        }

