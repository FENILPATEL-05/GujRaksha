        .psf-wrap .section-sub {
            font-size: 0.95rem;
            color: var(--muted);
            max-width: 680px;
            line-height: 1.6;
        }

        /* ── Journey header nav ── */
        .psf-wrap .journey-header-nav {
            margin: 0 0 14px;
            padding: 15px 16px;
