                "model-1": "Model 1: Registry & GIS Foundation",
                "model-2": "Model 2: Unified Viewing & Analytics",
                "model-3": "Model 3: VMS Federation & Middleware",
                "model-4": "Model 4: Central VMS & AI Platform",
                "model-hybrid": "Hybrid / Innovative Architecture"
            };

            function showOnlyModel(targetId) {
                var selected = document.getElementById(targetId);
                if (!selected) return;
                cards.forEach(function(card) {
                    card.classList.toggle("selected-model", card === selected);
                    card.open = card === selected;
                });
                options.forEach(function(opt) {
                    var active = opt.dataset.modelTarget === targetId;
                    opt.classList.toggle("model-link-active", active);
                    opt.setAttribute("aria-expanded", active ? "true" : "false");
                });
                if (activeTitle) activeTitle.textContent = labels[targetId] || targetId;
                step2.classList.add("model-selected");
                step2.open = true;
                window.setTimeout(function() {
                    var body = step2.querySelector(".journey-body");
                    if (body) body.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }, 60);
            }
            options.forEach(function(opt) {
                opt.addEventListener("click", function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    showOnlyModel(opt.dataset.modelTarget);
                });
                opt.addEventListener("keydown", function(e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        e.stopPropagation();
                        showOnlyModel(opt.dataset.modelTarget);
                    }
                });
            });
            step2.addEventListener("toggle", function() {
                if (!step2.open) {
                    step2.classList.remove("model-selected");
                    cards.forEach(function(c) {
                        c.classList.remove("selected-model");
                        c.open = false;
                    });
                    options.forEach(function(o) {
                        o.classList.remove("model-link-active");
                        o.setAttribute("aria-expanded", "false");
                    });
                    if (activeTitle) activeTitle.textContent = "Select a model above";
                }
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var steps = Array.from(document.querySelectorAll("details.journey-step"));
            var navButtons = Array.from(document.querySelectorAll(".step-nav-button"));

            function setActiveStep(step) {
                navButtons.forEach(function(btn) {
                    var active = step && btn.dataset.openStep === step.dataset.step;
                    btn.classList.toggle("active", Boolean(active));
                    btn.setAttribute("aria-pressed", active ? "true" : "false");
                });
            }

            navButtons.forEach(function(btn) {
                btn.setAttribute("aria-pressed", "false");
                btn.addEventListener("click", function(e) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    var step = document.querySelector('details.journey-step[data-step="' + btn
                        .dataset.openStep + '"]');
                    if (!step) return;
                    steps.forEach(function(s) {
                        s.open = s === step;
                    });
                    setActiveStep(step);
                    window.setTimeout(function() {
                        step.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });
                    }, 60);
                }, true);
            });

            steps.forEach(function(step) {
                step.addEventListener("toggle", function() {
                    if (step.open) {
                        steps.forEach(function(other) {
                            if (other !== step) other.open = false;
                        });
                        setActiveStep(step);
                    } else {
                        var anyOpen = steps.find(function(s) {
                            return s.open;
                        });
                        setActiveStep(anyOpen || null);
                    }
                });
            });

            var observer = new IntersectionObserver(function(entries) {
                var visible = entries
                    .filter(function(e) {
                        return e.isIntersecting;
                    })
                    .sort(function(a, b) {
                        return b.intersectionRatio - a.intersectionRatio;
                    });
                if (visible.length) setActiveStep(visible[0].target);
            }, {
                rootMargin: "-20% 0px -55% 0px",
                threshold: [0.1, 0.3, 0.6]
            });

            steps.forEach(function(step) {
                observer.observe(step);
            });
        });
    </script>

