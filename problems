    <script>
        (function() {
            let deadlineStr =
                '2026-08-29';
            const monthMap = {
                January: '01',
                February: '02',
                March: '03',
                April: '04',
                May: '05',
                June: '06',
                July: '07',
                August: '08',
                September: '09',
                October: '10',
                November: '11',
                December: '12'
            };
            deadlineStr = deadlineStr.replace(
                /(\d{1,2})\s+([A-Za-z]+),?\s+(\d{4})/,
                (_, d, m, y) => `${y}-${monthMap[m] || '08'}-${d.padStart(2,'0')}T23:59:59`
            );
            let deadline = new Date(deadlineStr).getTime();
            if (isNaN(deadline)) deadline = new Date('2026-08-31T23:59:59').getTime();

            function gcdTick() {
                const diff = deadline - Date.now();
                const ids = ['gcd-days', 'gcd-hours', 'gcd-mins', 'gcd-secs'];
                if (diff <= 0) {
                    ids.forEach(id => {
                        const el = document.getElementById(id);
                        if (el) el.textContent = '00';
                    });
                    return;
                }
                const vals = [
                    Math.floor(diff / 86400000),
                    Math.floor((diff % 86400000) / 3600000),
                    Math.floor((diff % 3600000) / 60000),
                    Math.floor((diff % 60000) / 1000)
                ];
                ids.forEach((id, i) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = String(vals[i]).padStart(2, '0');
                });
            }
            gcdTick();
            setInterval(gcdTick, 1000);
        })();
    </script>
        <script>
        document.addEventListener("DOMContentLoaded", function() {
            var steps = Array.from(document.querySelectorAll("details.journey-step"));
            var models = Array.from(document.querySelectorAll(".journey-step[data-step='B'] details.model-card"));
            var modelLinks = Array.from(document.querySelectorAll(".model-summary-list [data-model-target]"));

            function closeOtherSteps(activeStep) {
                steps.forEach(function(step) {
                    if (step !== activeStep) step.open = false;
                });
            }

            function closeOtherModels(activeModel) {
                models.forEach(function(model) {
                    if (model !== activeModel) model.open = false;
                });
                modelLinks.forEach(function(link) {
                    var isActive = activeModel && link.dataset.modelTarget === activeModel.id;
                    link.classList.toggle("model-link-active", Boolean(isActive));
                    link.setAttribute("aria-expanded", isActive ? "true" : "false");
                });
            }
            steps.forEach(function(step) {
                step.addEventListener("toggle", function() {
                    if (step.open) {
                        closeOtherSteps(step);
                    } else if (step.dataset.step === "B") {
                        closeOtherModels(null);
                    }
                });
            });
            models.forEach(function(model) {
                model.addEventListener("toggle", function() {
                    if (model.open) {
                        closeOtherModels(model);
                    } else {
                        var al = modelLinks.find(function(l) {
                            return l.dataset.modelTarget === model.id;
                        });
                        if (al) {
                            al.classList.remove("model-link-active");
                            al.setAttribute("aria-expanded", "false");
                        }
                    }
                });
            });

            function openSelectedModel(link) {
                var step = link.closest("details.journey-step");
                var model = document.getElementById(link.dataset.modelTarget);
                if (!step || !model) return;
                closeOtherSteps(step);
                step.open = true;
                closeOtherModels(model);
                model.open = true;
                window.setTimeout(function() {
                    model.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }, 80);
            }
            modelLinks.forEach(function(link) {
                link.setAttribute("aria-expanded", "false");
                link.addEventListener("click", function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    openSelectedModel(link);
                });
                link.addEventListener("keydown", function(e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        e.stopPropagation();
                        openSelectedModel(link);
                    }
                });
            });
            document.querySelectorAll(".summary-highlights:not(.model-summary-list)").forEach(function(list) {
                list.addEventListener("click", function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                });
            });
        });
    </script>
