            box-shadow: 0 14px 30px rgba(7, 52, 95, .18);
            overflow: hidden;
        }

        .psf-wrap .step-navigation {
            display: grid !important;
            grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
            gap: 8px !important;
            width: 100% !important;
            overflow: hidden !important;
            padding: 0 !important;
            margin: 0;
            border: 0;
            border-radius: 0;
            background: transparent;
            box-shadow: none;
            scrollbar-color: rgba(255, 255, 255, .35) transparent;
        }

        .psf-wrap .step-navigation-label {
            grid-column: 1 / -1 !important;
            margin: 0 0 8px;
            color: #ffffff;
            font-size: .82rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            opacity: .9;
        }

        .psf-wrap .step-nav-button {
            position: relative !important;
            min-width: 0 !important;
            width: 100% !important;
            min-height: 66px !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            justify-content: center !important;
            gap: 4px !important;
            padding: 9px 8px !important;
            border: 1px solid rgba(255, 255, 255, .28) !important;
            border-radius: 12px !important;
            background: rgba(255, 255, 255, .10) !important;
            color: #ffffff !important;
            text-align: left !important;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .15) !important;
            backdrop-filter: blur(8px);
            overflow: hidden;
            cursor: pointer;
            transition: transform .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease !important;
        }

        .psf-wrap .step-nav-button::before {
            content: "" !important;
            position: absolute !important;
            inset: 0 !important;
            background: linear-gradient(105deg, transparent 0 38%, rgba(255, 255, 255, .32) 48%, transparent 58% 100%) !important;
            transform: translateX(-130%) !important;
            animation: stepShimmer 4.2s ease-in-out infinite !important;
            animation-delay: calc(var(--step-index, 0) * .35s) !important;
            pointer-events: none !important;
        }

        .psf-wrap .step-nav-button::after {
            content: "" !important;
            position: absolute !important;
            right: 8px !important;
            top: 8px !important;
            width: 7px !important;
            height: 7px !important;
            border-radius: 50% !important;
            background: #ffffff !important;
            box-shadow: 0 0 0 0 rgba(255, 255, 255, .48) !important;
            animation: stepPulse 2.2s ease-out infinite !important;
            animation-delay: calc(var(--step-index, 0) * .22s) !important;
        }

        .psf-wrap .step-nav-button:nth-of-type(1) {
            --step-index: 0;
        }

        .psf-wrap .step-nav-button:nth-of-type(2) {
            --step-index: 1;
        }

        .psf-wrap .step-nav-button:nth-of-type(3) {
            --step-index: 2;
        }

        .psf-wrap .step-nav-button:nth-of-type(4) {
            --step-index: 3;
        }

        .psf-wrap .step-nav-button:nth-of-type(5) {
            --step-index: 4;
        }

        .psf-wrap .step-nav-button:nth-of-type(6) {
            --step-index: 5;
        }

        .psf-wrap .step-nav-button:nth-of-type(7) {
            --step-index: 6;
        }

        .psf-wrap .step-nav-button:hover {
            transform: translateY(-3px) !important;
            background: rgba(255, 255, 255, .20) !important;
            border-color: rgba(255, 255, 255, .62) !important;
            box-shadow: 0 10px 22px rgba(0, 0, 0, .16), inset 0 1px 0 rgba(255, 255, 255, .2) !important;
        }

        .psf-wrap .step-nav-button.active {
            transform: translateY(-3px) !important;
            background: #ffffff !important;
            color: #0b4776 !important;
            border-color: rgba(255, 255, 255, .62) !important;
            box-shadow: 0 10px 22px rgba(0, 0, 0, .16) !important;
        }

        .psf-wrap .step-nav-button.active::after {
            background: #ef3f5f !important;
            box-shadow: 0 0 0 0 rgba(239, 63, 95, .42) !important;
        }

        .psf-wrap .step-nav-number {
            position: relative;
            z-index: 2;
            display: block;
            font-size: .62rem !important;
            font-weight: 900;
            letter-spacing: .045em !important;
            text-transform: uppercase;
            opacity: .82;
            line-height: 1;
        }

        .psf-wrap .step-nav-name {
            position: relative;
            z-index: 2;
            display: block;
            font-size: clamp(.64rem, .72vw, .78rem) !important;
            font-weight: 800;
            line-height: 1.16 !important;
            overflow-wrap: anywhere !important;
        }

        @keyframes stepShimmer {

            0%,
            62% {
                transform: translateX(-130%);
                opacity: 0;
            }

            70% {
                opacity: 1;
            }

            88%,
            100% {
                transform: translateX(130%);
                opacity: 0;
            }
        }

        @keyframes stepPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 255, 255, .5);
            }

            65%,
            100% {
                box-shadow: 0 0 0 9px rgba(255, 255, 255, 0);
            }
        }

        /* ── Journey wrapper ── */
        .psf-wrap .journey-wrapper {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        /* ── Journey steps ── */
        .psf-wrap .journey-step {
            --step-color: var(--navy);
            --soft-step: color-mix(in srgb, var(--step-color) 9%, white);
            position: relative;
            margin: 24px 0;
            padding-left: 34px;
            border: 0;
            box-shadow: none;
            background: transparent;
            overflow: visible;
        }

        .psf-wrap .journey-step::before {
            content: "";
            position: absolute;
            left: 4px;
            top: 34px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            border: 4px solid var(--step-color);
            box-shadow: 0 0 0 6px color-mix(in srgb, var(--step-color) 11%, transparent), 0 5px 12px rgba(15, 23, 42, .12);
            z-index: 3;
        }

        .psf-wrap .journey-step:not(:last-of-type)::after {
            content: "";
            position: absolute;
            left: 11px;
            top: 55px;
            bottom: -30px;
            width: 2px;
            height: auto;
            background: linear-gradient(var(--step-color), color-mix(in srgb, var(--step-color) 15%, #d9e4ed));
            z-index: 0;
        }

        /* Step colors */
        .psf-wrap .journey-step[data-step="A"] {
            --step-color: #1769aa;
        }

        .psf-wrap .journey-step[data-step="B"] {
            --step-color: #6d28b7;
        }

        .psf-wrap .journey-step[data-step="C"] {
            --step-color: #0e8b8f;
        }

        .psf-wrap .journey-step[data-step="D"] {
            --step-color: #d97706;
        }

        .psf-wrap .journey-step[data-step="E"] {
            --step-color: #cf3a8b;
        }

        .psf-wrap .journey-step[data-step="F"] {
            --step-color: #218a50;
        }

        .psf-wrap .journey-step[data-step="G"] {
            --step-color: #283b9b;
        }

        /* Summary */
        .psf-wrap .journey-step>summary {
            position: relative;
            overflow: hidden;
            list-style: none;
            display: grid;
            grid-template-columns: 108px minmax(260px, 1fr) minmax(280px, .95fr) minmax(138px, auto) !important;
            gap: 20px;
            min-height: 126px;
            padding: 20px 22px 20px 20px;
            border: 1px solid color-mix(in srgb, var(--step-color) 20%, #d5e1ec);
            border-left: 0;
            border-radius: 22px;
            background:
                linear-gradient(90deg, var(--step-color) 0 8px, transparent 8px),
                linear-gradient(112deg, #ffffff 0%, #ffffff 66%, var(--soft-step) 100%);
            box-shadow: 0 15px 40px rgba(16, 43, 70, .10), 0 2px 7px rgba(16, 43, 70, .05);
            cursor: pointer;
            user-select: none;
            transition: none !important;
            transform: none !important;
        }

        .psf-wrap .journey-step>summary::-webkit-details-marker {
            display: none;
        }

        .psf-wrap .journey-step>summary::marker {
            display: none;
        }

        .psf-wrap .journey-step>summary::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: linear-gradient(120deg, rgba(255, 255, 255, .75), transparent 38%);
            pointer-events: none;
        }

        .psf-wrap .journey-step>summary::after {
            content: "";
            position: absolute;
            right: -65px;
            top: -82px;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            background: radial-gradient(circle, color-mix(in srgb, var(--step-color) 13%, transparent) 0 42%, transparent 43%);
            pointer-events: none;
        }

        .psf-wrap .journey-step[open]>summary {
            border-radius: 22px 22px 0 0;
            border-bottom-color: transparent;
            background:
                linear-gradient(90deg, var(--step-color) 0 8px, transparent 8px),
                linear-gradient(112deg, #fff 0%, color-mix(in srgb, var(--step-color) 7%, white) 100%);
            box-shadow: 0 22px 48px color-mix(in srgb, var(--step-color) 18%, transparent);
        }

        .psf-wrap .journey-step>summary:focus-visible {
            outline: 3px solid color-mix(in srgb, var(--step-color) 35%, transparent);
            outline-offset: 4px;
        }

        /* Step badge */
        .psf-wrap .step-badge {
            position: relative;
            z-index: 1;
            display: grid;
            place-items: center;
            min-height: 78px;
            border-radius: 18px;
            font-size: .98rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .055em;
            color: #fff;
            text-align: center;
            line-height: 1.15;
            background:
                linear-gradient(145deg, rgba(255, 255, 255, .20), transparent 45%),
                linear-gradient(145deg, color-mix(in srgb, var(--step-color) 75%, white), var(--step-color));
            border: 1px solid rgba(255, 255, 255, .35);
            box-shadow: 0 13px 28px color-mix(in srgb, var(--step-color) 25%, transparent),
                inset 0 1px rgba(255, 255, 255, .45), inset 0 -9px 16px rgba(0, 0, 0, .13);
            transition: transform .2s ease;
        }

        .psf-wrap .step-badge::before {
            content: "";
            display: block;
            width: 34px;
            height: 3px;
            margin-bottom: 7px;
            border-radius: 99px;
            background: rgba(255, 255, 255, .72);
            box-shadow: 0 7px 0 rgba(255, 255, 255, .32);
        }

        .psf-wrap .journey-step>summary:hover .step-badge {
            transform: scale(1.035);
        }

        /* Step title */
        .psf-wrap .summary-text.step-title {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .psf-wrap .summary-text.step-title strong {
            display: block;
            font-size: 1.18rem;
            font-weight: 900;
            line-height: 1.25;
            color: #0b2d4f;
            letter-spacing: .035em;
            text-transform: uppercase;
        }

        .psf-wrap .summary-text.step-title small {
            display: inline-block;
            width: max-content;
            margin-top: 9px;
            padding: 4px 10px;
            border-radius: 999px;
            color: var(--step-color);
            background: color-mix(in srgb, var(--step-color) 9%, white);
            font-weight: 800;
            font-size: .78rem;
            border: 1px solid color-mix(in srgb, var(--step-color) 18%, white);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .75);
        }

        .psf-wrap .summary-description {
            display: block;
            margin-top: 9px;
            max-width: 520px;
            color: #52657a;
            font-size: .9rem;
            line-height: 1.4;
        }

        /* Summary highlights */
        .psf-wrap .journey-step .summary-highlights {
            position: relative;
            z-index: 1;
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 10px 14px !important;
            align-self: center;
            list-style: none !important;
            padding: 0 !important;
            margin: 0 !important;
            columns: 1 !important;
        }

        .psf-wrap .journey-step .summary-highlights li {
            position: relative !important;
            min-height: 42px !important;
            display: flex !important;
            align-items: center !important;
            padding: 9px 12px 9px 34px !important;
            margin: 0 !important;
            border: 1px solid color-mix(in srgb, var(--step-color) 20%, #d8e3ee) !important;
            border-radius: 10px !important;
            background: color-mix(in srgb, var(--step-color) 5%, white) !important;
            box-shadow: none !important;
            color: #334155 !important;
            font-size: .96rem !important;
            line-height: 1.4 !important;
            transition: none !important;
            transform: none !important;
            cursor: default;
            user-select: text;
            pointer-events: none;
            break-inside: avoid;
        }

        .psf-wrap .journey-step .summary-highlights li::before {
            content: "" !important;
            position: absolute !important;
            left: 14px !important;
            top: 50% !important;
            transform: translateY(-50%) !important;
            width: 10px !important;
            height: 10px !important;
            border-radius: 50% !important;
            background: var(--step-color) !important;
            box-shadow: 0 0 0 5px color-mix(in srgb, var(--step-color) 13%, transparent) !important;
        }

        .psf-wrap .journey-step .summary-highlights li:hover {
            transform: none !important;
            background: color-mix(in srgb, var(--step-color) 5%, white) !important;
            border-color: color-mix(in srgb, var(--step-color) 20%, #d8e3ee) !important;
            box-shadow: none !important;
        }

        /* Chevron as "Click for more details" button */
        .psf-wrap .details-prompt {
            display: none !important;
        }

        .psf-wrap .journey-step>summary .chevron {
            position: relative;
            z-index: 2;
            width: auto !important;
            min-width: 138px !important;
            max-width: 170px !important;
            height: auto !important;
            min-height: 40px !important;
            padding: 7px 12px !important;
            border-radius: 12px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            background: rgba(255, 255, 255, .88) !important;
            border: 1px solid color-mix(in srgb, var(--step-color) 24%, #d6e2ec) !important;
            color: transparent !important;
            font-size: 0 !important;
            box-shadow: 0 8px 18px rgba(15, 23, 42, .10) !important;
            transform: none !important;
            transition: none !important;
            white-space: nowrap !important;
            justify-self: end !important;
            line-height: 1.15 !important;
        }

        .psf-wrap .journey-step>summary .chevron::before {
            content: "Click for more details";
            color: var(--step-color);
            font-size: .73rem !important;
            font-weight: 800;
            line-height: 1.2 !important;
            text-align: center !important;
            white-space: normal !important;
        }

        .psf-wrap .journey-step[open]>summary .chevron {
            background: color-mix(in srgb, var(--step-color) 8%, white) !important;
            color: transparent !important;
            transform: none !important;
        }

        .psf-wrap .journey-step[open]>summary .chevron::before {
            content: "Hide details";
            color: var(--step-color);
        }

        /* Journey body */
        .psf-wrap .journey-body {
            background: linear-gradient(180deg, #fff, #fbfdff);
            border: 1px solid color-mix(in srgb, var(--step-color) 20%, #d8e3ee);
            border-top: 0;
            border-radius: 0 0 20px 20px;
            padding: 22px;
            margin: 0 10px;
            box-shadow: 0 20px 42px rgba(16, 43, 70, .10);
            animation: revealPanel .28s ease both;
        }

        @keyframes revealPanel {
            from {
                opacity: 0;
                transform: translateY(-7px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        /* Panels */
        .psf-wrap .panel {
            background: white;
            border: 1px solid #dfe9f2;
            border-radius: 16px;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .045);
            padding: 24px;
            transition: none !important;
            transform: none !important;
        }

        .psf-wrap .panel h2,
        .psf-wrap .panel h3 {
            color: var(--navy);
            margin-top: 0;
        }

        .psf-wrap .panel p,
        .psf-wrap .panel li {
            font-size: 0.86rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* Notice */
        .psf-wrap .journey-notice {
            border-left: 5px solid var(--step-color, var(--accent));
            background: linear-gradient(90deg, color-mix(in srgb, var(--step-color, var(--accent)) 9%, white), #fff);
            padding: 16px 18px;
            border-radius: 10px;
            box-shadow: 0 6px 16px rgba(15, 23, 42, .04);
            font-size: 0.86rem;
            color: var(--text);
            line-height: 1.6;
        }

        /* Intro grid */
        .psf-wrap .intro-grid {
            display: grid;
            grid-template-columns: 1.25fr .75fr;
            gap: 22px;
            margin-bottom: 26px;
        }

        /* Single dropdown body */
        .psf-wrap .single-dropdown-body {
            margin-top: 16px;
        }

        /* Participant grid */
        .psf-wrap .participant-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
            margin-top: 10px;
        }

        .psf-wrap .participant-grid>div {
            background: linear-gradient(145deg, #f8fbfe, #f2f7fb);
            border: 1px solid #e3edf6;
            border-radius: 12px;
            padding: 16px;
        }

        .psf-wrap .participant-grid h4 {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--navy);
            margin: 6px 0 6px;
        }

        .psf-wrap .participant-grid p {
            font-size: 0.82rem;
            color: var(--muted);
            margin: 0;
            line-height: 1.6;
        }

        /* Tag */
        .psf-wrap .j-tag {
            display: inline-block;
            background: color-mix(in srgb, var(--step-color, var(--green)) 10%, white);
            color: var(--step-color, var(--green));
            border: 1px solid color-mix(in srgb, var(--step-color, var(--green)) 20%, white);
            padding: 4px 9px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 800;
            margin-bottom: 6px;
        }

        /* Architecture principles panel */
        .psf-wrap .architecture-principles-panel {
            margin-bottom: 16px;
            border-left: 5px solid #0e8b8f;
            background: linear-gradient(135deg, #f2fbfb, #ffffff);
        }

        .psf-wrap .architecture-principles-panel h3 {
            margin: 0 0 8px;
            color: #0e6f73;
        }

        .psf-wrap .architecture-principles-panel p {
            margin: 0;
            color: #334155;
            line-height: 1.65;
        }

        /* Details body */
        .psf-wrap .details-body {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
            padding: 16px 0 0;
        }

        .psf-wrap .details-body section {
            background: linear-gradient(145deg, #f8fbfe, #f2f7fb);
            border: 1px solid #e3edf6;
            border-radius: 12px;
            padding: 16px;
        }

        .psf-wrap .details-body section:first-child {
            grid-column: 1 / -1;
        }

        /* when a body holds exactly two sections the second would sit half-width
                       with dead space beside it — span it instead */
        .psf-wrap .details-body section:first-child:nth-last-child(2)~section {
            grid-column: 1 / -1;
        }

        .psf-wrap .details-body h4 {
            margin: 0 0 8px;
            color: var(--blue);
            font-size: 0.9rem;
            font-weight: 700;
        }

        .psf-wrap .details-body p,
        .psf-wrap .details-body li {
            font-size: 0.85rem;
            color: var(--text);
            line-height: 1.7;
        }

        /* Model introduction */
        .psf-wrap .model-introduction {
            grid-column: 1 / -1;
            background: linear-gradient(145deg, #f8fbfe, #f2f7fb) !important;
            border: 1px solid #dfe9f2 !important;
            border-radius: 12px !important;
            padding: 16px !important;
        }

        .psf-wrap .model-introduction h4 {
            color: var(--blue);
        }

        .psf-wrap .model-introduction p {
            margin: 0 0 10px;
        }

        .psf-wrap .model-introduction p:last-child {
            margin-bottom: 0;
        }

        /* Diagram */
        .psf-wrap .illustrative-diagram {
            grid-column: 1 / -1;
            background: linear-gradient(145deg, #f8fbff, #eef6fc) !important;
            border: 1px solid #d7e7f3 !important;
            overflow: hidden;
            border-radius: 12px;
            padding: 16px;
        }

        .psf-wrap .illustrative-diagram h4 {
            margin-bottom: 16px;
        }

        .psf-wrap .diagram-flow {
            display: grid;
            grid-template-columns: minmax(130px, 1fr) auto minmax(130px, 1fr) auto minmax(130px, 1fr) auto minmax(130px, 1fr) auto minmax(130px, 1fr);
            align-items: stretch;
            gap: 8px;
        }

        .psf-wrap .diagram-node {
            min-height: 112px;
            padding: 15px 12px;
            border-radius: 14px;
            border: 1px solid #cfe1ef;
            background: linear-gradient(145deg, #ffffff, #f2f8fc);
            box-shadow: 0 8px 20px rgba(11, 45, 79, .07);
            display: flex;
            flex-direction: column;
            justify-content: center;
            text-align: center;
        }

        .psf-wrap .diagram-node strong {
            display: block;
            color: #0b4776;
            font-size: .9rem;
            line-height: 1.3;
        }

        .psf-wrap .diagram-node span {
            display: block;
            margin-top: 7px;
            color: #61758a;
            font-size: .72rem;
            line-height: 1.35;
        }

        .psf-wrap .diagram-arrow {
            align-self: center;
            color: #1769aa;
            font-size: 1.55rem;
            font-weight: 900;
        }

        /* CTA block */
        .psf-wrap .cta-block {
            grid-column: 1 / -1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            flex-wrap: wrap;
            background: linear-gradient(135deg, rgba(11, 45, 79, .03) 0%, rgba(245, 158, 11, .06) 100%) !important;
            border: 1px solid var(--border) !important;
            border-radius: 14px;
            padding: 18px 20px;
        }

        .psf-wrap .cta-copy {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .psf-wrap .cta-label {
            display: inline-flex;
            align-items: center;
            width: fit-content;
            background: rgba(245, 158, 11, .12);
            color: var(--accent);
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            padding: 4px 8px;
            border-radius: 999px;
        }

        .psf-wrap .cta-copy h4 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: var(--navy);
        }

        .psf-wrap .cta-copy p {
            margin: 0;
            font-size: .88rem;
            color: var(--muted);
            line-height: 1.6;
        }

        .psf-wrap .btn-apply {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--accent), #ff8a3d);
            color: #fff;
            border: none;
            border-radius: 999px;
            padding: 10px 20px;
            font-size: .95rem;
            font-weight: 700;
            box-shadow: 0 10px 20px rgba(245, 158, 11, .2);
            transition: transform .2s ease, box-shadow .2s ease;
            text-decoration: none;
        }

        .psf-wrap .btn-apply:hover,
        .psf-wrap .btn-apply:focus {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(245, 158, 11, .25);
            text-decoration: none;
        }

        /* Model cards */
        .psf-wrap .model-card {
            background: #fff;
            border: 1px solid var(--border);
            border-left: 4px solid var(--blue);
            border-radius: 14px;
            margin-bottom: 8px;
            overflow: hidden;
        }

        .psf-wrap .model-card>summary {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            cursor: pointer;
            list-style: none;
